# 백엔드 주소. 컨테이너 안: http://backend:8000 / 로컬: http://127.0.0.1:8000 / Vercel: 공개 주소
BACKEND_ORIGIN=http://127.0.0.1:8000

# 시연 서버에서 백엔드 compose 가 만든 네트워크 이름. 보통 backend_default 다.
# `docker network ls` 로 확인한다.
BACKEND_NETWORK=backend_default

# 화면 접근 계정. DEMO_PASSWORD 가 비면 아무나 들어올 수 있다 — 시연 서버에서는 반드시 채운다.
# DEMO_USER 를 비우면 아이디는 검사하지 않고 비밀번호만 본다.
DEMO_USER=
DEMO_PASSWORD=

# 백엔드가 요구하는 열쇠 (backend D-26). 서버에서만 붙이고 브라우저에는 내려보내지 않는다.
# 비우면 헤더를 안 붙인다 — 열쇠 검사를 켜지 않은 로컬 백엔드와 그대로 맞는다.
API_KEY=
